---
import { getCollection } from 'astro:content';
import { COLLECTION_ORDER, COLLECTION_META, type CollectionKey } from '../data/collections';

const path = Astro.url.pathname;

const tree = await Promise.all(
  COLLECTION_ORDER.map(async (key) => {
    const entries = (await getCollection(key, ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
    );
    return { key, label: COLLECTION_META[key].label, entries };
  })
);
---

<div class="backdrop hidden fixed inset-0 z-30 bg-black/25 md:hidden" id="sidebar-backdrop"></div>

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 w-[78%] max-w-[280px] -translate-x-full overflow-y-auto border-r border-border bg-chrome text-[13px] transition-transform duration-150 md:static md:z-0 md:w-[230px] md:translate-x-0"
>
  <p class="px-3.5 pb-1 pt-2 font-mono text-[10px] uppercase tracking-wider text-ink-dim">Portfolio Tree</p>

  {tree.map(({ key, label, entries }) => (
    <div>
      <div class="flex items-center gap-1.5 px-2.5 py-1.5 pl-3.5 text-ink">
        <span class="w-2.5 text-[9px] text-ink-dim">▾</span>
        <span>📁</span>
        <a href={`/${key}/`} class={`hover:underline ${path === `/${key}/` ? 'font-semibold text-accent-dim' : ''}`}>
          {label}
        </a>
      </div>
      {entries.map((entry) => {
        const href = `/${key}/${entry.id}/`;
        const active = path === href;
        return (
          <a
            href={href}
            class={`flex items-center gap-1.5 py-1 pl-[34px] pr-2.5 text-[12.5px] ${
              active ? 'bg-accent-bg font-semibold text-accent-dim' : 'text-ink-dim hover:bg-chrome-dark hover:text-ink'
            }`}
          >
            📄 {entry.data.title}
          </a>
        );
      })}
    </div>
  ))}
</aside>

<script>
  const sidebar = document.getElementById('sidebar');
  const backdrop = document.getElementById('sidebar-backdrop');
  const toggle = document.getElementById('tree-toggle');

  function openDrawer() {
    sidebar?.classList.remove('-translate-x-full');
    backdrop?.classList.remove('hidden');
  }
  function closeDrawer() {
    sidebar?.classList.add('-translate-x-full');
    backdrop?.classList.add('hidden');
  }
  toggle?.addEventListener('click', () => {
    sidebar?.classList.contains('-translate-x-full') ? openDrawer() : closeDrawer();
  });
  backdrop?.addEventListener('click', closeDrawer);
</script>
