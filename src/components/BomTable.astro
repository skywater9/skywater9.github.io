---
interface Row {
  href: string;
  item: string;
  title: string;
  tags: string[];
  date: string;
}
interface Props {
  rows: Row[];
}
const { rows } = Astro.props;
---

<div class="mt-4 w-full overflow-x-auto">
<table class="w-full min-w-[520px] border-collapse bg-white text-[12.5px]">
  <thead>
    <tr>
      <th class="border-b border-border bg-chrome px-3 py-2 text-left font-mono text-[10.5px] uppercase tracking-wide text-ink-dim">Item</th>
      <th class="border-b border-border bg-chrome px-3 py-2 text-left font-mono text-[10.5px] uppercase tracking-wide text-ink-dim">Description</th>
      <th class="border-b border-border bg-chrome px-3 py-2 text-left font-mono text-[10.5px] uppercase tracking-wide text-ink-dim">Tags</th>
      <th class="border-b border-border bg-chrome px-3 py-2 text-left font-mono text-[10.5px] uppercase tracking-wide text-ink-dim">Date</th>
    </tr>
  </thead>
  <tbody>
    {rows.length === 0 ? (
      <tr><td colspan="4" class="px-3 py-8 text-center font-mono text-ink-dim">Nothing here yet — coming soon.</td></tr>
    ) : (
      rows.map((row) => (
        <tr class="cursor-pointer border-b border-[#e7e9e5] hover:bg-accent-bg" onclick={`window.location='${row.href}'`}>
          <td class="px-3 py-2.5 align-top font-mono text-accent-dim">{row.item}</td>
          <td class="px-3 py-2.5 align-top"><a href={row.href} class="hover:underline">{row.title}</a></td>
          <td class="px-3 py-2.5 align-top">
            {row.tags.map((t) => (
              <span class="mr-1 inline-block rounded border border-border px-1.5 py-0.5 text-[10.5px] text-ink-dim">{t}</span>
            ))}
          </td>
          <td class="px-3 py-2.5 align-top whitespace-nowrap">{row.date}</td>
        </tr>
      ))
    )}
  </tbody>
</table>
</div>
