---
import { COLLECTION_ORDER, COLLECTION_META } from '../data/collections';

const path = Astro.url.pathname;
const isHome = path === '/';
---

<header class="sticky top-0 z-20">
  <!-- titlebar -->
  <div class="flex items-center gap-2.5 border-b border-border bg-gradient-to-b from-[#f5f6f4] to-[#e7e9e5] px-3.5 py-2.5">
    <a href="/" class="flex items-center gap-1.5 text-[13px] font-semibold text-ink">
      <svg width="17" height="17" viewBox="0 0 16 16" class="shrink-0">
        <path d="M8 1 L14.5 4.8 V11.2 L8 15 L1.5 11.2 V4.8 Z" fill="none" stroke="#d9662c" stroke-width="1.3" />
        <path d="M8 1 V15 M1.5 4.8 L14.5 11.2 M14.5 4.8 L1.5 11.2" stroke="#d9662c" stroke-width="0.6" opacity=".5" />
      </svg>
      Student Name — Engineering Portfolio
      <span class="font-normal text-ink-dim">· Rev 2026-07</span>
    </a>
  </div>

  <!-- menu bar: real, meaningful nav -->
  <nav class="flex gap-0.5 overflow-x-auto border-b border-border bg-chrome px-2 text-[13px]">
    <a href="/" class={`whitespace-nowrap rounded-t px-3 py-2 hover:bg-chrome-dark ${isHome ? 'bg-panel font-semibold shadow-[inset_0_-2px_0_var(--color-accent)]' : ''}`}>
      Home
    </a>
    {COLLECTION_ORDER.map((key) => (
      <a
        href={`/${key}/`}
        class={`whitespace-nowrap rounded-t px-3 py-2 hover:bg-chrome-dark ${
          path.startsWith(`/${key}`) ? 'bg-panel font-semibold shadow-[inset_0_-2px_0_var(--color-accent)]' : ''
        }`}
      >
        {COLLECTION_META[key].label}
      </a>
    ))}
    <a href="/about/" class={`whitespace-nowrap rounded-t px-3 py-2 hover:bg-chrome-dark ${path === '/about/' ? 'bg-panel font-semibold shadow-[inset_0_-2px_0_var(--color-accent)]' : ''}`}>
      About
    </a>
  </nav>

  <!-- toolbar -->
  <div class="flex items-center gap-1.5 border-b border-border bg-chrome px-2.5 py-1.5">
    <a href="/" title="Home" class="flex h-[30px] w-[30px] items-center justify-center rounded text-accent-dim hover:bg-chrome-dark">⌂</a>
    <button id="tree-toggle" title="Show sections" class="flex h-[30px] w-[30px] items-center justify-center rounded text-ink-dim hover:bg-chrome-dark md:hidden">☰</button>
    <div class="mx-1.5 h-5 w-px bg-border"></div>
    <div class="flex max-w-[320px] flex-1 items-center gap-1.5 rounded border border-border bg-white px-3 py-1.5 text-[12.5px] text-ink-dim">
      🔍 Search projects…
    </div>
    <div class="flex-1"></div>
    <a href="/resume.pdf" title="Download résumé" class="flex h-[30px] w-[30px] items-center justify-center rounded text-ink-dim hover:bg-chrome-dark">⬇</a>
  </div>
</header>
