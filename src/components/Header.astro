---
import { COLLECTION_ORDER, COLLECTION_META } from '../data/collections';

const path = Astro.url.pathname;
const isHome = path === '/';
---

<header class="sticky top-0 z-20">
  <!-- titlebar -->
  <div class="flex items-center gap-2.5 border-b border-border bg-shell py-1.5 pl-2.5 pr-3.5">
    <a href="/" class="text-[13px] text-ink">
      <span><span class="text-accent">DEMIR <strong>GOKSU</strong></span> — Engineering Portfolio</span>
      <span class="font-normal text-ink-dim">· Rev 2026-07</span>
    </a>
  </div>

  <!-- menu bar: real, meaningful nav -->
  <nav class="flex gap-0.5 overflow-x-auto border-b border-divider bg-shell pl-0 pr-2 text-[13px]">
    <a href="/" class={`relative whitespace-nowrap border py-2 pl-[38px] pr-3 hover:bg-[#d6d6d6] ${isHome ? 'border-[#b0b0b0] bg-[#d6d6d6]' : 'border-transparent'}`}>
      <img src="/images/ui/home-icon.png" alt="" aria-hidden="true" class="absolute left-0.5 top-1/2 h-8 w-8 -translate-y-1/2 object-contain" />
      <span>Home</span>
    </a>
    {COLLECTION_ORDER.map((key) => (
      <a
        href={`/${key}/`}
        class={`whitespace-nowrap border px-3 py-2 hover:bg-[#d6d6d6] ${
          path.startsWith(`/${key}`) ? 'border-[#b0b0b0] bg-[#d6d6d6]' : 'border-transparent'
        }`}
      >
        {COLLECTION_META[key].label}
      </a>
    ))}
    <a href="/about/" class={`relative whitespace-nowrap border py-2 pl-[42px] pr-3 hover:bg-[#d6d6d6] ${path === '/about/' ? 'border-[#b0b0b0] bg-[#d6d6d6]' : 'border-transparent'}`}>
      <img src="/images/ui/about-icon.png" alt="" aria-hidden="true" class="absolute left-2 top-1/2 h-7 w-7 -translate-y-1/2 object-contain" />
      <span>About</span>
    </a>
  </nav>

</header>
