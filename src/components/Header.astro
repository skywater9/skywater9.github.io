---
import Toolbar from './Toolbar.astro';
import { NAVIGATION } from '../data/navigation';

const path = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
---

<header class="sticky top-0 z-20 shrink-0">
  <div class="flex h-6 items-center gap-2.5 border-b border-border bg-shell pl-2.5 pr-3.5">
    <a href="/" class="flex h-full min-w-0 items-center gap-2 text-[13px]">
      <span class="shrink-0 text-accent">DEMIR <strong>GOKSU</strong></span>
      <span aria-hidden="true" class="h-full w-px shrink-0 bg-border"></span>
      <span class="truncate font-medium text-[#1d2024]">Engineering Portfolio</span>
      <span class="hidden shrink-0 font-normal text-[#3f4449] sm:inline">· Rev 2026-07</span>
    </a>
  </div>

  <div class="flex flex-col border-b border-divider bg-shell text-[13px] lg:flex-row">
    <nav aria-label="Main navigation" class="flex min-w-0 items-center gap-0.5 overflow-x-auto lg:shrink-0">
      {NAVIGATION.map(({ label, href }) => (
        <a
          href={href}
          aria-current={path === href ? 'page' : undefined}
          class={`relative shrink-0 whitespace-nowrap border py-2 pr-3 hover:border-[#4d7694] hover:bg-[#a7c8e2] ${href === '/' ? 'pl-[38px]' : 'pl-3'} ${path === href ? 'border-[#4d7694] bg-[#a7c8e2]' : 'border-transparent'}`}
        >
          {href === '/' && <img src="/images/ui/home-icon.png" alt="" aria-hidden="true" class="absolute left-0.5 top-1/2 h-8 w-8 -translate-y-1/2 object-contain" />}
          <span>{label}</span>
        </a>
      ))}
    </nav>
    <Toolbar />
  </div>
</header>

<script>
  // Keep the selected page visible in the horizontally scrolling mobile tabs.
  const navigation = document.querySelector<HTMLElement>('nav[aria-label="Main navigation"]');
  if (navigation && navigation.scrollWidth > navigation.clientWidth) {
    navigation.querySelector('[aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
</script>
