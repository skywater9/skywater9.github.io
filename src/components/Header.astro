---
import Toolbar from './Toolbar.astro';

const path = Astro.url.pathname;
const isHome = path === '/';
---

<header class="sticky top-0 z-20">
  <div class="flex h-6 items-center gap-2.5 border-b border-border bg-shell pl-2.5 pr-3.5">
    <a href="/" class="flex h-full items-center gap-2 text-[13px]">
      <span class="text-accent">DEMIR <strong>GOKSU</strong></span>
      <span aria-hidden="true" class="h-full w-px bg-border"></span>
      <span class="font-medium text-[#1d2024]">Engineering Portfolio</span>
      <span class="font-normal text-[#3f4449]">· Rev 2026-07</span>
    </a>
  </div>

  <nav class="flex items-center gap-0.5 border-b border-divider bg-shell text-[13px]">
    <a href="/" class={`relative whitespace-nowrap border py-2 pl-[38px] pr-3 hover:border-[#4d7694] hover:bg-[#a7c8e2] ${isHome ? 'border-[#4d7694] bg-[#a7c8e2]' : 'border-transparent'}`}>
      <img src="/images/ui/home-icon.png" alt="" aria-hidden="true" class="absolute left-0.5 top-1/2 h-8 w-8 -translate-y-1/2 object-contain" />
      <span>Home</span>
    </a>
    <Toolbar />
  </nav>
</header>
