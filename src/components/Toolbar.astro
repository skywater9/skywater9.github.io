<div class="ml-auto flex w-[180px] shrink-0 self-stretch items-center px-3 sm:w-[300px] lg:w-[360px]">
  <form
    id="project-search"
    role="search"
    class="relative flex h-7 min-w-0 max-w-[338px] flex-1 items-center gap-2 border border-divider bg-shell px-[3px] text-[14px] text-ink-dim"
  >
    <button type="submit" title="Search projects" aria-label="Search projects" class="shrink-0">
      <img src="/images/ui/search-icon.png" alt="" aria-hidden="true" class="h-7 w-7 object-contain" />
    </button>
    <input
      id="project-search-input"
      type="search"
      placeholder="Search projects…"
      aria-label="Search projects"
      autocomplete="off"
      class="min-w-0 flex-1 bg-transparent text-black outline-none placeholder:text-ink-dim"
    />
  </form>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('#project-search');
  const input = document.querySelector<HTMLInputElement>('#project-search-input');

  input?.addEventListener('input', () => input.setCustomValidity(''));

  // Project pages are temporarily retired; keep search without stale results.
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!input) return;

    input.setCustomValidity(input.value.trim() ? 'No projects available to search yet.' : 'Enter a project name.');
    input.reportValidity();
  });
</script>
