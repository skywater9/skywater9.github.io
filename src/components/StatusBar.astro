---
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
---

<footer class="flex items-center justify-between border-t border-border bg-shell px-3.5 py-1.5 font-mono text-[11px] text-ink-dim">
  <span>{currentPath}</span>
  <div class="flex items-center gap-3">
    <a href="mailto:example@email.com" class="hover:text-accent-dim">Email</a>
    <a href="https://github.com/skywater9" class="hover:text-accent-dim">GitHub</a>
    <a href="https://linkedin.com/in/yourprofile" class="hover:text-accent-dim">LinkedIn</a>
    <span class="text-ok">● synced from GitHub</span>
  </div>
</footer>
