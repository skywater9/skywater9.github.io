---
interface Props {
  index: string;
  label: string;
}
const { index, label } = Astro.props;
---

<div class="flex max-w-[600px] gap-3 py-3.5">
  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-accent font-mono text-[11px] text-accent-dim">
    {index}
  </span>
  <div>
    <p class="mb-1 font-mono text-[10.5px] uppercase tracking-wider text-accent-dim">{label}</p>
    <p class="text-[13px] leading-relaxed text-ink-dim"><slot /></p>
  </div>
</div>
