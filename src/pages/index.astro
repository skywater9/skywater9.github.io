---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Demir Göksu — Engineering Portfolio" statusPath="Home">
  <article class="mx-auto max-w-[760px] space-y-8 p-6 pb-[30vh] text-[13.5px] leading-relaxed md:p-8 md:pb-[30vh]">
    <header class="min-h-[30vh]">
      <h1 class="text-2xl font-bold md:text-[26px]">Home</h1>
      <p class="mt-3 max-w-[600px] text-ink-dim">Placeholder content to demonstrate the page outline. Scroll through the sections or select a heading in the sidebar.</p>
    </header>

    <section class="border-t border-border pt-6">
      <h2 class="text-xl font-semibold">Engineering Projects</h2>
      <p class="mt-3 text-ink-dim">An introduction to engineering work can go here. Replace this text with your own overview.</p>

      <section class="min-h-[40vh] pt-10">
        <h3 class="text-base font-semibold">Design and Prototyping</h3>
        <p class="mt-3 text-ink-dim">Placeholder for sketches, CAD models, prototypes, and the decisions behind a design.</p>
      </section>
      <section class="min-h-[40vh] pt-6">
        <h3 class="text-base font-semibold">Testing and Iteration</h3>
        <p class="mt-3 text-ink-dim">Placeholder for testing methods, observations, and improvements made along the way.</p>
      </section>
    </section>

    <section class="border-t border-border pt-6">
      <h2 class="text-xl font-semibold">Additional Projects</h2>
      <p class="mt-3 text-ink-dim">Use this space to introduce projects beyond engineering.</p>

      <section class="min-h-[40vh] pt-10">
        <h3 class="text-base font-semibold">Creative Work</h3>
        <p class="mt-3 text-ink-dim">Placeholder for writing, photography, or other creative projects.</p>
      </section>
    </section>

    <section class="border-t border-border pt-6">
      <h2 class="text-xl font-semibold">Background and Interests</h2>
      <p class="mt-3 text-ink-dim">A short introduction to your background and interests can go here.</p>

      <section class="min-h-[40vh] pt-10">
        <h3 class="text-base font-semibold">What I'm Exploring</h3>
        <p class="mt-3 text-ink-dim">Placeholder for topics you are learning about or ideas you would like to explore.</p>
      </section>
    </section>

    <section class="min-h-[40vh] border-t border-border pt-6">
      <h2 class="text-xl font-semibold">Next Steps</h2>
      <p class="mt-3 text-ink-dim">Placeholder for future plans. These demo sections can be renamed, reordered, or removed as you add real content.</p>
    </section>
  </article>
</Layout>
