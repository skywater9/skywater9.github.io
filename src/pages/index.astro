---
import Layout from '../layouts/Layout.astro';
import PropertiesPanel from '../components/PropertiesPanel.astro';

const rows = [
  { k: 'Role', v: 'High School Senior · Class of 2027' },
  { k: 'Sections', v: 'Research · FRC Robotics · CAD Design · Rocket Design · STEM Outreach' },
  { k: 'Last Updated', v: '2026-07' },
];

const highlights = [
  'Independent research mentored by an MIT Mechanical Engineering Ph.D. candidate, building a custom tensile-testing system to validate a topology optimization framework',
  'Design Lead for FRC Team 1148, leading CAD development for robots that competed at the FIRST World Championship',
  'Founded remote CAD workshops for a rookie robotics team at Hatay Science High School, in a region rebuilding after the 2023 earthquake',
  'Co-President of the Rocketry Club, designing and flying rockets to about 3,000 ft through UCLA\u2019s Summer Engineering Design program',
  'Harvard-Westlake School, 3.95 UW / 4.23 W GPA, 1540 SAT',
];

const awards = [
  { award: "FIRST Robotics Competition Dean's List Semifinalist", year: '2026' },
  { award: 'FIRST World Championship Qualifier', year: '2025' },
  { award: 'VEX World Championship Qualifier', year: '2024' },
  { award: 'Team First Award, FRC Team 1148', year: '2026' },
];
---

<Layout title="Student Name — Engineering Portfolio" description="Research, FRC robotics, CAD design, rocketry, and STEM outreach work." statusPath="Home">
  <div class="p-4 md:p-5">
    <p class="font-mono text-[12.5px] font-semibold uppercase tracking-wide text-accent-dim">About Me</p>
    <h1 class="mt-2 text-2xl font-bold md:text-[26px]">Student Name</h1>
    <p class="mt-2.5 max-w-[480px] text-[13.5px] leading-relaxed text-ink-dim">
      I'm a high school engineer who likes turning ideas into tested, working hardware, from a
      custom tensile-testing rig for materials research to CAD leadership on a FIRST Robotics team.
      I'm just as interested in teaching what I know, and currently run weekly CAD workshops for a
      rookie robotics program in Hatay, Turkey.
    </p>

    <ul class="mt-4 max-w-[520px] space-y-2">
      {highlights.map((h) => (
        <li class="flex gap-2.5 text-[13px] leading-relaxed text-ink-dim">
          <span class="mt-0.5 text-accent-dim">-</span>
          <span>{h}</span>
        </li>
      ))}
    </ul>

    <PropertiesPanel rows={rows} />

    <h2 class="mt-8 text-xl font-bold">Leadership &amp; Awards</h2>
    <p class="mt-2.5 max-w-[480px] text-[13.5px] leading-relaxed text-ink-dim">
      Co-President of Turkish Club, and founder of a Turkish-American Academic Speaker Series
      connecting students with university researchers in engineering, biology, and AI.
    </p>

    <div class="mt-4 max-w-[480px] w-full overflow-x-auto">
    <table class="w-full border-collapse bg-white text-[12.5px]">
      <thead>
        <tr>
          <th class="border-b border-border bg-chrome px-3 py-2 text-left font-mono text-[10.5px] uppercase tracking-wide text-ink-dim">Award</th>
          <th class="border-b border-border bg-chrome px-3 py-2 text-left font-mono text-[10.5px] uppercase tracking-wide text-ink-dim">Year</th>
        </tr>
      </thead>
      <tbody>
        {awards.map((a) => (
          <tr class="border-b border-[#e7e9e5]">
            <td class="px-3 py-2.5">{a.award}</td>
            <td class="px-3 py-2.5">{a.year}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>
</Layout>
