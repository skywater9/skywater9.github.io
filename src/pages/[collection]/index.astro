---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BomTable from '../../components/BomTable.astro';
import { COLLECTION_ORDER, COLLECTION_META, type CollectionKey } from '../../data/collections';

export async function getStaticPaths() {
  return COLLECTION_ORDER.map((collection) => ({ params: { collection } }));
}

const collection = Astro.params.collection as CollectionKey;
const meta = COLLECTION_META[collection];

const entries = (await getCollection(collection, ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const rows = entries.map((entry, i) => ({
  href: `/${collection}/${entry.id}/`,
  item: String(i + 1).padStart(2, '0'),
  title: entry.data.title,
  tags: entry.data.tags,
  date: new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(entry.data.date),
}));
---

<Layout title={`${meta.label} — Portfolio`} description={meta.blurb} statusPath={meta.label}>
  <div class="p-4 md:p-5">
    <p class="font-mono text-[10.5px] uppercase tracking-wide text-accent-dim">Sheet {meta.sheet}</p>
    <h1 class="mt-2 text-2xl font-bold md:text-[26px]">{meta.label}</h1>
    <p class="mt-2.5 max-w-[480px] text-[13.5px] leading-relaxed text-ink-dim">{meta.blurb}</p>

    <BomTable rows={rows} />
  </div>
</Layout>
