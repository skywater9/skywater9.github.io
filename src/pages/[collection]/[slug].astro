---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Callout from '../../components/Callout.astro';
import { COLLECTION_ORDER, COLLECTION_META, type CollectionKey } from '../../data/collections';

export async function getStaticPaths() {
  const paths = [];
  for (const collection of COLLECTION_ORDER) {
    const entries = await getCollection(collection);
    for (const entry of entries) {
      paths.push({ params: { collection, slug: entry.id }, props: { entry } });
    }
  }
  return paths;
}

const { collection } = Astro.params;
const { entry } = Astro.props;
const meta = COLLECTION_META[collection as CollectionKey];
const { Content } = await render(entry);
const links = [
  { label: 'GitHub', href: entry.data.github },
  { label: 'CAD', href: entry.data.cad },
  { label: 'Demo', href: entry.data.demo },
].filter((l) => l.href);
---

<Layout title={`${entry.data.title} — ${meta.label}`} description={entry.data.summary} statusPath={`${meta.label} / ${entry.data.title}`}>
  <div class="p-4 md:p-5">
    <p class="font-mono text-[10.5px] uppercase tracking-wide text-accent-dim">{meta.label}</p>
    <h1 class="mt-1 text-2xl font-bold md:text-[26px]">{entry.data.title}</h1>
    <p class="mt-2.5 max-w-[600px] text-[13.5px] leading-relaxed text-ink-dim">{entry.data.summary}</p>
    {entry.data.credit && <p class="mt-1 font-mono text-[11px] text-ink-dim">{entry.data.credit}</p>}

    {entry.data.tags.length > 0 && (
      <div class="mt-2.5">
        {entry.data.tags.map((tag: string) => (
          <span class="mr-1.5 inline-block rounded border border-border px-1.5 py-0.5 text-[10.5px] text-ink-dim">{tag}</span>
        ))}
      </div>
    )}

    {links.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2.5">
        {links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded border border-accent px-3 py-1.5 font-mono text-[11px] text-accent-dim hover:bg-accent hover:text-white"
          >
            {l.label} ↗
          </a>
        ))}
      </div>
    )}

    {entry.data.cover && (
      <img
        src={entry.data.cover}
        alt={entry.data.title}
        class="mt-5 max-w-[600px] rounded border border-border object-cover"
        loading="eager"
        onerror="window.__imgFallback(this)"
      />
    )}

    {entry.data.cadEmbed && (
      <div class="mt-5 max-w-[600px]">
        <p class="mb-1.5 font-mono text-[11px] text-ink-dim">Interactive CAD</p>
        <div class="aspect-video w-full overflow-hidden rounded border border-border">
          <iframe src={entry.data.cadEmbed} class="h-full w-full" loading="lazy" allowfullscreen title={`${entry.data.title} — CAD viewer`}></iframe>
        </div>
      </div>
    )}

    {entry.data.video && (
      <div class="mt-5 max-w-[600px]">
        <div class="aspect-video w-full overflow-hidden rounded border border-border">
          <iframe src={entry.data.video} class="h-full w-full" loading="lazy" allowfullscreen title={`${entry.data.title} — video`}></iframe>
        </div>
      </div>
    )}

    {entry.data.gallery.length > 0 && (
      <div class="mt-5 max-w-[600px]">
        <p class="mb-1.5 font-mono text-[11px] text-ink-dim">Gallery</p>
        <div class="grid grid-cols-3 gap-2">
          {entry.data.gallery.map((src: string) => (
            <img src={src} alt="" class="aspect-square w-full rounded border border-border object-cover" loading="lazy" onerror="window.__imgFallback(this)" />
          ))}
        </div>
      </div>
    )}

    <div class="mt-6 max-w-[600px] border-t border-border pt-1">
      <Callout index="01" label="Problem">{entry.data.problem}</Callout>
      <Callout index="02" label="Approach">{entry.data.approach}</Callout>
      <Callout index="03" label="Result">{entry.data.result}</Callout>
      <Callout index="04" label="Lesson">{entry.data.lesson}</Callout>
    </div>

    <div class="prose prose-sm mt-6 max-w-[600px] prose-headings:font-semibold prose-a:text-accent-dim">
      <Content />
    </div>
  </div>
</Layout>
