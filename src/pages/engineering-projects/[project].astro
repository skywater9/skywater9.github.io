---
import Layout from '../../layouts/Layout.astro';
import { getEngineeringProjects } from '../../data/engineering-projects';

export function getStaticPaths() {
  return getEngineeringProjects().map((project) => ({
    params: { project: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.name} — Engineering Projects`} statusPath={project.name}>
  {project.bannerImage && (
    <div class="banner-image-fade relative h-[calc(min(32vw,300px)+50px)] min-h-[194px] overflow-hidden">
      <img
        src={project.bannerImage}
        alt={`${project.name} banner`}
        class="block h-full w-full object-cover object-center"
      />
      <div aria-hidden="true" class="absolute inset-0 bg-black/[33%]"></div>
    </div>
  )}
  <div class="mx-auto max-w-[900px] p-6 md:p-8">
    <h1 class="text-2xl font-bold md:text-[26px]">{project.name}</h1>
  </div>
</Layout>
