---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Toolbar from '../components/Toolbar.astro';
import Sidebar from '../components/Sidebar.astro';
import StatusBar from '../components/StatusBar.astro';

interface Props {
  title: string;
  description?: string;
  statusPath?: string;
}

const { title, description = 'Engineering project portfolio.', statusPath = 'Home' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

  </head>
  <body class="flex h-screen flex-col overflow-hidden">
    <Header />
    <div class="relative grid min-h-0 flex-1 grid-cols-1 grid-rows-[auto_minmax(0,1fr)] overflow-hidden md:grid-cols-[230px_minmax(0,1fr)]">
      <Toolbar />
      <Sidebar />
      <main class="viewport-grid row-start-2 min-w-0 overflow-y-auto md:col-start-2 md:row-span-2 md:row-start-1 md:pt-[10px]">
        <slot />
        <img
          src="/images/ui/axis-icon.png"
          alt=""
          aria-hidden="true"
          class="axis-icon viewport-overlay pointer-events-none fixed bottom-10 left-3 z-10 h-[84px] w-[84px] select-none object-contain md:left-[242px]"
        />
      </main>
    </div>
    <StatusBar currentPath={statusPath} />
  </body>
</html>
