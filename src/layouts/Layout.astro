---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
  statusPath?: string;
  fillHeight?: boolean;
}

const { title, description = 'Engineering project portfolio.', statusPath = 'Home', fillHeight = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      if (localStorage.getItem('page-outline-desktop-expanded') === 'false') {
        document.documentElement.dataset.sidebarExpanded = 'false';
      }
    </script>

  </head>
  <body class="flex h-screen flex-col overflow-hidden">
    <Header />
    <div id="page-shell" class="page-shell relative grid min-h-0 flex-1 grid-rows-[minmax(0,1fr)] overflow-hidden">
      <Sidebar />
      <div class="sidebar-edge-control">
        <button
          id="sidebar-edge-toggle"
          class="sidebar-edge-toggle"
          type="button"
          aria-controls="sidebar"
          aria-label="Toggle sidebar"
          title="Toggle sidebar"
        >
          <svg viewBox="0 0 16 18" width="14" height="18" fill="none" aria-hidden="true">
            <path d="m10 4-5 5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <main id="page-viewport" aria-label={statusPath} class="viewport-grid row-start-1 min-w-0 overflow-y-auto md:col-start-2 md:row-start-1">
        <div id="page-content" class={fillHeight ? 'h-full' : undefined}><slot /></div>
      </main>
    </div>
  </body>
</html>
